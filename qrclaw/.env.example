# ============================================
# QRClaw 配置文件示例
# ============================================
# 复制此文件到项目根目录，命名为 .env，填入实际值
# cp .env.example .env
#
# 完整配置项说明：https://docs.litellm.ai/docs/providers
# ============================================

# ============ LLM Provider 配置 ============
# 推荐使用 litellm（统一调用库，支持 100+ 提供商）
LLM_PROVIDER=litellm

# LiteLLM API 密钥（必填）
LITELLM_API_KEY=your-api-key-here

# 默认模型（LiteLLM 格式: provider/model）
# 支持的提供商：
#   - openai: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#   - anthropic: claude-3-5-sonnet-20241022, claude-3-opus
#   - vertex_ai: gemini-1.5-pro, gemini-1.5-flash
#   - deepseek: deepseek-chat
#   - azure: azure/<deployment-name>
#   - ollama: ollama/llama2, ollama/codellama
#   - orcarouter: orcarouter/fusion, orcarouter/fusion-mini, orcarouter/auto（OpenAI 兼容路由网关）
#   - 以及 100+ 更多...
LITELLM_MODEL=gpt-4o

# LiteLLM 基础 URL（可选，用于自定义 API 端点）
# 使用 OrcaRouter 时填：https://api.orcarouter.ai/v1
LITELLM_BASE_URL=

# LiteLLM API Base（可选，与 LITELLM_BASE_URL 类似）
LITELLM_API_BASE=

# 代理服务器（可选，如需代理访问）
LITELLM_PROXY_URL=

# ============ Agent 配置 ============
AGENT_NAME=QRClaw
MODEL_MAX_TOKENS=128000
MAX_ITERATIONS=100

# ============ 压缩配置 ============
# 摘要目标 token 数（默认 10% 上下文窗口）
COMPRESS_SUMMARY_MAX_TOKENS=2560

# 最近消息目标 token 数（默认 12% 上下文窗口）
COMPRESS_RECENT_MAX_TOKENS=1536

# ============ 外部 API ============
# Tavily 网页搜索（可选）
TAVILY_API_KEY=

# ============ 心跳配置 ============
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL=3600

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_MAX_DAYS=30
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_CONSOLE_LEVEL=WARNING

# ============================================
# 其他提供商 API Key（LiteLLM 自动识别）
# 如需使用多个提供商，只需填入对应的 API Key
# ============================================

# Azure OpenAI
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=2024-02-01

# Anthropic（Claude 系列）
# ANTHROPIC_API_KEY=

# Google AI / Vertex（Gemini 系列）
# GOOGLE_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# OrcaRouter（OpenAI 兼容路由网关，https://www.orcarouter.ai）
# LITELLM_MODEL=orcarouter/fusion
# LITELLM_BASE_URL=https://api.orcarouter.ai/v1
# LITELLM_API_KEY=sk-orca-...

# Cohere
# COHERE_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# Hugging Face
# HUGGINGFACE_API_KEY=

# AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1
