# QRClaw 配置说明
#
# 新版本配置统一存放在 ~/.qrclaw/config 文件中
# 首次启动时会自动创建该文件
#
# 如果项目目录下有 .env 文件，会自动迁移到 ~/.qrclaw/config
# 迁移后建议删除项目目录下的 .env 文件
#
# 配置文件位置：
#   macOS/Linux: ~/.qrclaw/config
#   Windows: C:\Users\你的用户名\.qrclaw\config
#
# 配置项说明：

# Agent 配置
AGENT_NAME=QRClaw
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
MODEL_MAX_TOKENS=128000
MAX_ITERATIONS=50

# Tavily API（网页搜索）
TAVILY_API_KEY=

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_DAYS=30
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_CONSOLE_LEVEL=WARNING