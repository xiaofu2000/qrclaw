  "narrative": {
    "northStar": "冷蓝玻璃暗棚",
    "overview": "用户选定 AH 的 Human Brain 与 Aether 1 冷蓝玻璃方向。完整人脑的自然褶皱承担主体细节，暗场、窄条反射与短中文标题共同建立空间感。\n\n本文件管理独立两阶段样片的版式；正式官网已接入同一个 AH 模型与玻璃方向，其四阶段布局由 `../../DESIGN.md` 和 `../../.impeccable/design.json` 管理。两者共享当前 `src/brain-scene.js` 与 `src/brain-camera.js`，不是彼此冻结的旧版本。样片构图见[表面契约](../../.impeccable/surfaces/brain-preview.md)。",
    "keyCharacteristics": [
      "深蓝黑暗场、冰蓝反射与白色文字。",
      "真实模型褶皱、透射与透明度共同构成玻璃体积。",
      "大幅留白、短标题、细线导航与胶囊动态控制。"
    ],
    "rules": [
      {
        "name": "The Dark Refraction Rule",
        "body": "透射背景必须存在于 WebGL 场景内；CSS 背景不能代替玻璃采样所需的暗场。",
        "section": "colors"
      },
      {
        "name": "The Direct Title Rule",
        "body": "标题直接进入正文主题，不增加眉题或“VISUAL STUDY / 01”装饰标签。",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** 保留真实模型、可见署名及原始资产证据。",
      "**Do** 让标题、镜头、阶段状态共享进度，并保持键盘和减少动态模式可用。",
      "**Do** 将移动浏览器视口检查与真实设备性能验证分开记录。"
    ],
    "donts": [
      "**Don't** 将样片的两阶段版式当作正式官网四阶段布局，或把共享渲染器当作独立旧版本。",
      "**Don't** 用透明 WebGL 画布加 CSS 暗底代替真实透射背景。",
      "**Don't** 添加卡通表情、替代脑模型或装饰眉题。"
    ]
  }
